{
  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Quest: main",
      "type": "node",
      "program": "main.ts",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "/opt/homebrew/bin/deno",
      "runtimeArgs": [
        "run",
        "--inspect-wait",
        "--allow-all"
      ],
      "args": [
        "animate"
      ],
      "attachSimplePort": 9229,
      "console": "integratedTerminal"
    }
  ]
}