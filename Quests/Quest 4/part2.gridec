HEADS AA/A/A

START   **/*/* RIGHT    **/*/* SD/D/D
RIGHT   **/*/* COMPARE  **/*/* RR/S/D

COMPARE ==/#/* COMPARE  **/*/* RR/S/S
COMPARE |=/#/* TRIM     ||/*/* RR/S/S
COMPARE =|/#/* TRIM     ||/*/* RR/S/S
COMPARE **/_/* STOP     **/*/* SS/S/S

TRIM    ==/#/* TRIM     __/#/* RR/S/S
TRIM    _=/#/* TRIM     __/#/* RR/S/S
TRIM    =_/#/* TRIM     __/#/* RR/S/S
TRIM    _|/#/# REWIND   __/#/* LL/S/S
TRIM    _|/#/_ STOP     __/#/* SS/S/S
TRIM    |_/#/* REWIND   __/#/* LL/S/S
TRIM    ||/#/* REWIND   __/#/* LL/S/S

REWIND  __/#/* REWIND   **/#/* LL/S/S
REWIND  ||/#/* DOWN     **/#/* DD/D/D

DOWN    **/_/* STOP     **/*/* SS/S/S
DOWN    |_/#/* RESET    __/*/* LL/S/S
DOWN    |=/#/* TRIM     ||/*/* RR/S/S
DOWN    ||/#/* DOWN     **/*/* DD/D/D

RESET   *_/#/* RESET    __/*/* LL/S/S
RESET   *|/*/* UP       ||/*/* UU/U/U

UP      =|/#/* UP       **/*/* UU/U/U
UP      ==/#/* UP       **/*/* UU/U/U
UP      |*/#/* TRIM     ||/*/* RR/S/S
UP      _|/#/* UP1      **/*/* DD/D/D
UP      _=/#/* UP1      **/*/* DD/D/D
UP1     **/#/* TRIM     ||/*/* RR/S/S