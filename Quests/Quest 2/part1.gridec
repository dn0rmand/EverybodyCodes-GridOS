HEADS AABB

START A**A RUN a**a SRLS
START A**B RUN a**b SRLS
START B**A RUN b**a SRLS
START B**B RUN b**b SRLS

RUN AAAA RUN @**@ RRLL
RUN AABB RUN @**@ RRLL
RUN AAAB RUN @**_ RRLL
RUN AABA RUN @**_ RRLL
RUN BBAA RUN @**@ RRLL
RUN BBBB RUN @**@ RRLL
RUN BBAB RUN @**_ RRLL
RUN BBBA RUN @**_ RRLL
RUN ABAA RUN _**@ RRLL
RUN ABBB RUN _**@ RRLL
RUN ABAB RUN _**_ RRLL
RUN ABBA RUN _**_ RRLL
RUN BAAA RUN _**@ RRLL
RUN BABB RUN _**@ RRLL
RUN BAAB RUN _**_ RRLL
RUN BABA RUN _**_ RRLL

RUN aAAa RUN @aa@ RRLL
RUN aABb RUN @ab@ RRLL
RUN aAAb RUN @aa_ RRLL
RUN aABa RUN @ab_ RRLL
RUN bBAa RUN @ba@ RRLL
RUN bBBb RUN @bb@ RRLL
RUN bBAb RUN @ba_ RRLL
RUN bBBa RUN @bb_ RRLL
RUN aBAa RUN _ba@ RRLL
RUN aBBb RUN _bb@ RRLL
RUN aBAb RUN _ba_ RRLL
RUN aBBa RUN _bb_ RRLL
RUN bAAa RUN _aa@ RRLL
RUN bABb RUN _ab@ RRLL
RUN bAAb RUN _aa_ RRLL
RUN bABa RUN _ab_ RRLL

RUN a_@a STOP __@_ SSSS
RUN *aa* STOP *@_* SSSS
RUN *ab* STOP *__* SSSS
RUN bbbb STOP *@_* SSSS
RUN *ba* STOP *__* SSSS
RUN a__a STOP ____ SSSS
RUN b__b STOP ____ SSSS
RUN b@_b STOP _@*_ SSSS